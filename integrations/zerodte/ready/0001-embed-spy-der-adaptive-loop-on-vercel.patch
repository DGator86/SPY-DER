+@app.api_route("/api/spy-der/v1/{path:path}", methods=["GET", "HEAD", "POST"])
+async def api_spy_der_v1_proxy(path: str, request: Request):
+    """Pass-through to spy-der-dashboard-api (Adaptive Loop + operator writes).
+
+    Prefer this over the legacy file-reader routes so the Vercel embed and the
+    SPY-DER ``/ui`` tab share one implementation. Operator POSTs require
+    ``X-Spy-Der-Operator-Token`` (Vercel rewrites Authorization to DASHBOARD_TOKEN).
+    """
+    import urllib.error
+    import urllib.request
+
+    base = os.environ.get("SPY_DER_DASHBOARD_URL", "http://127.0.0.1:8788").rstrip("/")
+    qs = request.url.query
+    target = f"{base}/v1/{path}" + (f"?{qs}" if qs else "")
+
+    headers = {"Accept": request.headers.get("accept") or "application/json"}
+    operator = request.headers.get("x-spy-der-operator-token")
+    if operator:
+        headers["Authorization"] = f"Bearer {operator}"
+        headers["X-Spy-Der-Operator-Token"] = operator
+    body = await request.body() if request.method == "POST" else None
+    if request.method == "POST":
+        headers["Content-Type"] = request.headers.get("content-type") or "application/json"
+
+    req = urllib.request.Request(target, data=body, headers=headers, method=request.method)
+    try:
+        with urllib.request.urlopen(req, timeout=30) as upstream:
+            payload = upstream.read()
+            content_type = upstream.headers.get("Content-Type") or "application/json"
+            return Response(content=payload, status_code=upstream.status, media_type=content_type)
+    except urllib.error.HTTPError as exc:
+        payload = exc.read()
+        content_type = exc.headers.get("Content-Type") or "application/json"
+        return Response(content=payload, status_code=exc.code, media_type=content_type)
+    except urllib.error.URLError as exc:
+        return JSONResponse(
+            status_code=502,
+            content={
+                "detail": "spy-der-dashboard-api unreachable — is it running on :8788?",
+                "error": str(exc.reason),
+                "target": target,
+            },
+        )
+
+
