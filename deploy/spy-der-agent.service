[Unit]
Description=SPY-DER decision agent (local HTTP /v1/decision + live_state publisher)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spy-der
Group=spy-der
WorkingDirectory=/opt/spy-der
EnvironmentFile=-/etc/spy-der/spy-der.env
StateDirectory=spy-der
Environment=SPY_DER_STATE_ROOT=%S/spy-der
ExecStart=/opt/spy-der/venv/bin/spy-der decision-service --host 127.0.0.1 --port 8787
Restart=always
RestartSec=5

# Live trading is forbidden. This unit only serves decisions and publishes state.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/spy-der

[Install]
WantedBy=multi-user.target
