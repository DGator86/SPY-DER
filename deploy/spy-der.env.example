# SPY-DER environment — install to /etc/spy-der/spy-der.env (mode 0640, root:spy-der).
#
# Secrets live here and nowhere else. Never commit real values; never place a key
# in source, in config.yaml, or in a chat message.
#
# There is deliberately no reference to any legacy 0DTE path: after cutover
# SPY-DER has no runtime dependency on 0DTE. This is enforced by
# tests/unit/test_deploy_independence.py, which fails on any such path.

# ---------------------------------------------------------------------------
# State and configuration
# ---------------------------------------------------------------------------
SPY_DER_STATE_ROOT=/var/lib/spy-der
SPY_DER_CONFIG=/etc/spy-der/config.yaml

# ---------------------------------------------------------------------------
# Market-data providers (ordered failover is set in config.yaml)
# ---------------------------------------------------------------------------
# Massive / Polygon-compatible options snapshots.
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
# bearer (default) | query — switch to query if the host returns 401 on Bearer.
MASSIVE_AUTH=bearer

TRADIER_API_KEY=
TRADIER_BASE_URL=https://api.tradier.com

TASTYTRADE_USERNAME=
TASTYTRADE_PASSWORD=
TASTYTRADE_BASE_URL=https://api.tastyworks.com

# Yahoo needs no key; used as an underlying/settlement backstop only.

# ---------------------------------------------------------------------------
# AI decision authority
# ---------------------------------------------------------------------------
XAI_API_KEY=
# Killswitch: 0/false/off/no forces the deterministic agent with no HTTP calls.
SPY_DER_AI=1
# Cap candidates sent to the model (0 or negative sends all).
SPY_DER_AI_TOP_K=8
# Spend gates for the flagship reviewer; 0 reviews every TRADE.
XAI_REVIEW_MIN_CONFIDENCE=0.0
XAI_REVIEW_MIN_SIZE=0.0

# ---------------------------------------------------------------------------
# Execution guard — deterministic limits (spy_der.execution.guard)
# ---------------------------------------------------------------------------
# The guard can only shrink exposure. Omitting a limit yields the conservative
# built-in default, never an unbounded one.
SPY_DER_MAX_LOSS_PER_TRADE=500
SPY_DER_MAX_CAPITAL_PER_TRADE=2500
SPY_DER_MAX_SIZE_SCALAR=1.0
SPY_DER_MAX_CONTRACTS=10
SPY_DER_MAX_OPEN_POSITIONS=3
SPY_DER_MAX_POSITIONS_PER_FAMILY=1
SPY_DER_MIN_FILL_PROBABILITY=0.35
SPY_DER_MAX_QUOTE_AGE_SECONDS=5

# Execution mode: shadow | paper | live.
SPY_DER_EXECUTION_MODE=shadow
# Live routing is opt-in and fails closed. Do not set this to 1 until cutover
# step 7 has a human sign-off recorded.
SPY_DER_ALLOW_LIVE=0
# Operator killswitch: 0 blocks every mode, including shadow.
SPY_DER_TRADING_ENABLED=1

# ---------------------------------------------------------------------------
# Notifications (optional)
# ---------------------------------------------------------------------------
SPY_DER_NOTIFY_WEBHOOK=
