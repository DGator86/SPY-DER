[Unit]
# Weekend deep dojo: full lattice + calibration window. Never auto-promotes.
Description=SPY-DER dojo — weekly full lattice
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=spy-der
Group=spy-der
WorkingDirectory=/opt/spy-der
EnvironmentFile=-/etc/spy-der/spy-der.env
StateDirectory=spy-der
Environment=SPY_DER_STATE_ROOT=%S/spy-der
ExecStart=/opt/spy-der/venv/bin/spy-der dojo \
    --reports-dir /var/lib/spy-der/reports/dojo \
    --configs-dir /var/lib/spy-der/configs \
    --experience-dir /var/lib/spy-der/inbox/experience \
    --full-lattice \
    --days 8 \
    --generations 2 \
    --trials 25

TimeoutStartSec=4h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/spy-der

StandardOutput=journal
StandardError=journal
SyslogIdentifier=spy-der-dojo-weekly

SuccessExitStatus=0
