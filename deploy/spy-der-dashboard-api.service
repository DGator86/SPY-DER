[Unit]
# Dashboard data services. Binds loopback only: the Vercel frontend reaches it
# through a reverse proxy, so the API is never directly internet-facing.
Description=SPY-DER dashboard API (state reads + operator knob promotion)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spy-der
Group=spy-der
WorkingDirectory=/opt/spy-der
EnvironmentFile=-/etc/spy-der/spy-der.env
StateDirectory=spy-der
Environment=SPY_DER_STATE_ROOT=%S/spy-der
ExecStart=/opt/spy-der/venv/bin/spy-der dashboard-api \
    --host 127.0.0.1 \
    --port 8788 \
    --state-root %S/spy-der
Restart=always
RestartSec=5

# Reads are open; writes are limited to configs/ (champion + pending_review).
# Promote / Reject require SPY_DER_OPERATOR_TOKEN in spy-der.env.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/spy-der
ReadWritePaths=/var/lib/spy-der/configs

StandardOutput=journal
StandardError=journal
SyslogIdentifier=spy-der-dashboard-api

[Install]
WantedBy=multi-user.target
