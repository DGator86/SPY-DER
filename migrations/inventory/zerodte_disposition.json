  "tree_manifest": "migrations/inventory/zerodte_tree.txt",
  "tracked_paths": 328,
  "note": "Disposition ledger for the full-stack migration. Every tracked path in the tree manifest must match exactly one rule; tests/unit/test_migration_inventory.py enforces that no path is ambiguous and no rule is dead. Rules are evaluated in order and the FIRST match wins, so narrower rules precede broader ones.",
  "dispositions": {
    "move": "Code relocated into SPY-DER with behavior preserved; the mathematics is not rewritten. Parity is proven against the 0DTE golden before the 0DTE copy is retired.",
    "reimplement": "Capability rebuilt behind a SPY-DER-owned interface because the 0DTE implementation is coupled to flat-module imports (unified_loop, gate_scorer) that cannot cross the boundary intact. Behavior is held to the same parity gate.",
    "replace": "SPY-DER already owns a working implementation of this capability. The 0DTE module is superseded once parity passes; no code moves.",
    "archive": "Retained read-only for provenance (baselines, handoff docs, historical reports). Not carried into the SPY-DER runtime.",
    "delete": "Removed outright. Either a temporary migration bridge whose purpose ends at cutover, or dead/duplicated code with no SPY-DER counterpart needed."
  },
  "rules": [
    {
      "match": "massive_feed.py",
      "capability": "Market feed — Massive/Polygon-compatible options snapshot",
      "disposition": "reimplement",
      "spy_der_owner": "spy_der.market_data.providers.massive",
      "status": "done",
      "parity_gate": "raw_market_snapshots",
      "notes": "Ported to spy_der.market_data.providers.massive. HTTP client, field mappings, day-close fallback tagging, pagination cap and ATM put-call-parity spot recovery (including the high-bias fix) all preserved. Now also fetches 1-minute aggregates and a dedicated underlying snapshot, so spot walks a measured ladder (options snapshot, underlying quote, newest minute close) before falling back to parity, and each rung is recorded as a quality flag. Not yet verified against the live endpoint — tested against fixtures reproducing the feed's documented absences."
    },
