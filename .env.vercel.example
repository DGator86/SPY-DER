# Required: reachable base URL of spy-der-dashboard-api (no trailing slash).
# The API binds 127.0.0.1:8788 on the VPS, so this must be a tunnel or reverse
# proxy that forwards to that port — not the raw loopback address.
#
# Direct (preferred once a SPY-DER tunnel exists):
#   SPY_DER_DASHBOARD_URL=https://spy-der-api.example.com
#
# Temporary via the 0DTE VPS hop (already proxies /api/spy-der → :8788):
#   SPY_DER_DASHBOARD_URL=https://<vps-host>/api/spy-der
#   DASHBOARD_TOKEN=<same token 0DTE dashboard expects>
SPY_DER_DASHBOARD_URL=

# Optional. Only needed when SPY_DER_DASHBOARD_URL goes through a hop that
# requires Authorization (e.g. the 0DTE FastAPI dashboard). Direct tunnels to
# :8788 leave this unset — reads are open; operator writes use the browser
# paste of SPY_DER_OPERATOR_TOKEN as X-Spy-Der-Operator-Token.
DASHBOARD_TOKEN=
